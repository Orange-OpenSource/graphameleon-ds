PREFIX ucoact: <https://ontology.unifiedcyberontology.org/uco/action#>
PREFIX ucobs: <https://ontology.unifiedcyberontology.org/uco/observable#>
PREFIX core: <https://ontology.unifiedcyberontology.org/uco/core#>
PREFIX types: <https://ontology.unifiedcyberontology.org/uco/types#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Extract ucobs:startTime and ucobs:endTime values in order to compute
# entity inter-arrival times and durations.

SELECT
    ?item ?timestamp ?timestamp_end ?duration
    ?item_parent ?item_parent_timestamp ?action_to_connection_delta_time
    ?item_previous ?item_previous_timestamp ?action_to_action_delta_time
WHERE {
    # Get ucobs:HTTPConnectionFacet items and their timing
    ?item ucobs:startTime ?timestamp ;
        ucobs:endTime ?timestamp_end .
    BIND( (xsd:dateTime(?timestamp_end) - xsd:dateTime(?timestamp)) AS ?duration)

    OPTIONAL {
        # Get the ucoact:ObservableAction the item is ucobs:object of
        ?item ^ucobs:object ?item_parent .
        ?item_parent core:objectCreatedTime ?item_parent_timestamp .

        # Get the ucoact:ObservableAction chain, backward
        ?item_parent types:threadPreviousItem ?item_previous.
        ?item_previous core:objectCreatedTime ?item_previous_timestamp.
    }
    BIND( (xsd:dateTime(?timestamp) - xsd:dateTime(?item_parent_timestamp)) AS ?action_to_connection_delta_time)
    BIND( (xsd:dateTime(?item_parent_timestamp) - xsd:dateTime(?item_previous_timestamp)) AS ?action_to_action_delta_time)

} ORDER BY ?timestamp